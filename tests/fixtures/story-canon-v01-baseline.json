  "legacy": [
    {
      "id": 12,
      "story": [
        [
          "설오",
          "짐을 풀 시간도 없이 달아난 모양입니다. 사람이 갈 길부터 확보하겠습니다.",
          {
            "storyId": "act2-v1:act2-r2-entry-12",
            "storyTitle": "돌산으로 가는 길"
          }
        ],
        [
          "휘겸",
          "벼랑 아래가 비었소. 저 바위를 받친 나무를 끊으면 홈이 메워지겠군. 다만 작업장부터 조용하게 만들어야 하오.",
          {
            "storyId": "act2-v1:act2-r2-entry-12",
            "storyTitle": "돌산으로 가는 길"
          }
        ],
        [
          "소단",
          "저 수레에는 아직 아무것도 없어요. 그런데 바퀴가 떨리고 있어요. 멀리서 부르는 소리를 기다리는 것처럼.",
          {
            "storyId": "act2-v1:act2-r2-entry-12",
            "storyTitle": "돌산으로 가는 길"
          }
        ]
      ],
      "outro": [
        [
          "설오",
          "절벽 뒤가 통째로 꺼져 있습니다. 밑으로 내려가는 돌계단이 남았습니다.",
          {
            "storyId": "act2-v1:act2-r2-outro-12",
            "storyTitle": "돌산으로 가는 길"
          }
        ],
        [
          "소단",
          "울림은 더 아래에서 와요. 여기까지 밀려 나온 것보다, 안에 남은 쪽이 훨씬 많아요.",
          {
            "storyId": "act2-v1:act2-r2-outro-12",
            "storyTitle": "돌산으로 가는 길"
          }
        ]
      ],
      "beats": {
        "rock-pin": [
          [
            "휘겸",
            "돌이 물렸소. 가운데부터 밟으시오. 바깥 가장자리는 아직 흘러내릴 수 있소."
          ]
        ],
        "sign": [
          [
            "서술",
            "길표를 세우는 순간 암벽 안쪽에서 낮은 울림이 왔다. 텅 빈 수레의 멍에가 들리고, 바퀴가 일제히 일행 쪽으로 돌아섰다."
          ],
          [
            "소단",
            "지금 들어갔어요. 산에서 나온 혼이 수레 안으로!"
          ],
          [
            "담허",
            "소리가 길을 열고 있군. 먼저 올라간 것들이 되돌아오지 못하게 막아야겠네."
          ]
        ],
        "clear-approach": [
          [
            "서술",
            "쓰러진 도구 사이에서 작은 짚신 한 짝이 나왔다. 설오는 그것을 길표 밑의 마른 돌 위에 놓았다."
          ],
          [
            "설오",
            "아이도 이 길로 내려왔습니다. 돌아올 때 주인을 찾을 수 있으면 좋겠습니다."
          ]
        ],
        "hold-road": [
          [
            "서술",
            "마지막 수레가 옆으로 쓰러졌다. 부서진 짐칸 아래에서 동굴마을로 향하는 길표가 다시 드러났다."
          ],
          [
            "휘겸",
            "이 정도 수레를 썼다면 안에는 작은 작업장만 있는 게 아니오."
          ]
        ]
      }
    },
    {
      "id": 16,
      "story": [
        [
          "설오",
          "아래 마을에서 왔습니다. 종에 관한 기록을 찾습니다. 먼저 이분을 도와드리겠습니다.",
          {
            "storyId": "act2-v1:act2-r2-entry-16",
            "storyTitle": "잠운사"
          }
        ],
        [
          "노승",
          "내 제자요. 제 이름을 놓칠까 봐 손에 써 주고 있소. 어릴 때도 이렇게 글을 배웠는데.",
          {
            "storyId": "act2-v1:act2-r2-entry-16",
            "storyTitle": "잠운사"
          }
        ],
        [
          "소단",
          "곁에 붙은 혼부터 약하게 만들면 떼어낼 수 있어요. 손은 놓지 말아 주세요.",
          {
            "storyId": "act2-v1:act2-r2-entry-16",
            "storyTitle": "잠운사"
          }
        ],
        [
          "노승",
          "기록함 열쇠는 내게 있소. 종지기에게 내주지 않은 것이 그것 하나뿐이오.",
          {
            "storyId": "act2-v1:act2-r2-entry-16",
            "storyTitle": "잠운사"
          }
        ]
      ],
      "outro": [
        [
          "노승",
          "제자를 살렸다고 이 절이 한 일이 없어지지는 않겠지요. 기록도, 우리 말도 가져가시오.",
          {
            "storyId": "act2-v1:act2-r2-outro-16",
            "storyTitle": "잠운사"
          }
        ],
        [
          "설오",
          "두고 가지 않겠습니다. 뒤편 인양로부터 확인하겠습니다.",
          {
            "storyId": "act2-v1:act2-r2-outro-16",
            "storyTitle": "잠운사"
          }
        ]
      ],
      "beats": {
        "monk": [
          [
            "승려",
            "스님. 손이 아픕니다."
          ],
          [
            "노승",
            "그래. 아프다고 말할 수 있으면 됐다. 네 이름부터 다시 말해 보아라."
          ],
          [
            "서술",
            "제자가 제 이름을 말했다. 노승은 대답 대신 손바닥에 묻은 먹을 소매로 닦아 주었다."
          ]
        ],
        "record": [
          [
            "서술",
            "장부에는 대종을 울리는 법보다 울림을 멈추는 절차가 길게 적혀 있었다. “이름을 불러 모았으면, 이름을 놓아 보내라. 천도 뒤에는 다시 울리지 말라.” 마지막 장은 칼로 잘려 있었다."
          ],
          [
            "담허",
            "혼을 모으는 종이지만 가두기 위한 종은 아니었네. 불러 모은 뒤 내보내는 것이 끝이었어."
          ],
          [
            "설오",
            "끝내는 절차만 없앤 겁니까?"
          ],
          [
            "담허",
            "누가 잘랐는지는 아직 모르네. 다만 저 아래에서는 끝내지 못한 울림이 계속되고 있지."
          ]
        ],
        "witness": [
          [
            "승려",
            "처음에는 종 안에서 돌로 두드렸어요. 이튿날에는 손으로. 사흘째에는 문 가까운 데서만 소리가 났어요."
          ],
          [
            "설오",
            "그동안 꺼낼 수 있었습니까?"
          ],
          [
            "승려",
            "인양틀이 살아 있었습니다. 종지기가 축을 빼고 문을 잠갔어요. 우리가 손대면 밖의 사람까지 죽는다고 했습니다."
          ],
          [
            "승려",
            "내가 들은 건 저주가 아니었어요. 물을 달라는 말이었어요. 그래도 나는 돌아섰습니다."
          ],
          [
            "휘겸",
            "그 말을 적어 둡시다. 안에 있던 사람을 모르는 혼으로 부르지 않도록."
          ]
        ],
        "hall": [
          [
            "노승",
            "종을 옮긴 날의 문서요. 기름에 젖지 않게 싸 두었소. 밖에서 들리는 소리는 잠깐만 막아 주시오."
          ],
          [
            "휘겸",
            "문 앞은 맡기시오. 읽어야 할 것까지 다시 빼앗기지는 않겠소."
          ]
        ]
      }
    },
    {
      "id": 19,
      "story": [
        [
          "담허",
          "불러 모으는 길은 오래 열려 있었네. 이제 바깥으로 가는 길을 잇겠네.",
