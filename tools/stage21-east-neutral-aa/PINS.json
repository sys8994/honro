  "exactPatch": {
    "from": "     G.HonroVectorArt.draw(raw,flow.owner,{x:0,y:0});",
    "to": "     let owner=flow.owner;\n     if(b.honroStage===21&&b.honroCanonical===true&&b.honroCustom===false&&b.honroMapOrigin==='campaign'&&\n        b.honroAuthoredId==='stage-21'&&owner.id==='act3-handoff:21:bedrock'&&x0===5740&&x1===6400){\n      if(!flow.eastNeutralAA){\n       const v=owner.vector,key='s21-east-terminal-neutral-proof';\n       if(v.root?.clipPath!=='sourceAlpha'||!Array.isArray(v.clips?.sourceAlpha)||Object.hasOwn(v.clips,key))\n        throw Error('Stage21 neutral A/A root mismatch');\n       const wrap=node=>{\n        if(node.tag!=='g')throw Error('Stage21 neutral A/A expected original group');\n        if(node.children.length===1&&node.children[0].tag==='g')return{...node,children:[wrap(node.children[0])]};\n        if(node.children.length!==8||node.children.some(x=>x.tag!=='path'))throw Error('Stage21 neutral A/A expected all 8 original leaves');\n        return{...node,children:[{tag:'g',clipPath:key,children:node.children}]};\n       };\n       flow.eastNeutralAA={...owner,vector:{...v,root:wrap(v.root),clips:{...v.clips,[key]:['M-16000 -16000 H16000 V16000 H-16000Z']}}};\n      }\n      owner=flow.eastNeutralAA;\n      const q=raw.getTransform(),p=G.__honroStage21NeutralAA??={total:0,last:null};\n      p.total++;p.last={row:[x0,x1],matrix:[...matrix],outer:[m.a,m.b,m.c,m.d,m.e,m.f],\n       transform:[q.a,q.b,q.c,q.d,q.e,q.f],canvas:[raw.canvas.width,raw.canvas.height],tiled:this._staticCacheBuild===true};\n     }\n     G.HonroVectorArt.draw(raw,owner,{x:0,y:0});"
  },
