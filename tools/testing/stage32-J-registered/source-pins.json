  "patches": [
    {
      "path": "shared/build.mjs",
      "old": "'act4-campaign','act4-pilot-art'",
      "new": "'act4-campaign','stage32-foundation-art','act4-pilot-art'",
      "label": "Register only Stage32 helper before consumer"
    },
    {
      "path": "shared/runtime/act4-pilot-art.js",
      "old": " 'act4-handoff:32:body-joined':{'approved32-east-face':['#626b70','#879193']},",
      "new": " 'act4-handoff:32:body-joined':{'approved32-east-face':['#626b70','#879193']},\n 'act4-handoff:32:body-shared-material':{'approved32-east-face':['#626b70','#879193']},",
      "label": "Matching source contact underlay for new provider"
    },
    {
      "path": "shared/runtime/act4-pilot-art.js",
      "old": "   if(G.HonroVectorArt?.draw(raw,l.asset,l))return;",
      "new": "   if(b?.honroStage===32&&G.HonroStage32FoundationArt?.draw(raw,l,b,false,{sceneScale:this.scale,nativeLive:this.scale>1.05}))return;\n   if(G.HonroVectorArt?.draw(raw,l.asset,l))return;",
      "label": "Explicit stage32-only dispatch; no3/7/33/34/37/38 hooks"
    },
    {
      "path": "shared/act4-handoff-art.mjs",
      "old": "  const compatibilityAssetIds=[];",
      "new": "  // A separate material provider preserves the old foundation and saved battles.\n  if(n===32)pack.assets.push(JSON.parse(await readFile(new URL('./data/act4/handoff-art/32-foundation.json',import.meta.url),'utf8')));\n  const compatibilityAssetIds=[];",
      "label": "Append independent Stage32 foundation"
    },
    {
      "path": "shared/act4-handoff-art.mjs",
      "old": "  const bodyId=assetId(n,n===32?\"body-joined\":\"body\");",
      "new": "  const bodyId=assetId(n,n===32?\"body-shared-material\":\"body\");",
      "label": "Only Stage32 active BODY provider"
    },
    {
      "path": "shared/act4-handoff-art.mjs",
      "old": "  const elements=stage.elements.flatMap(element=>{",
      "new": "  const elements=stage.elements.flatMap(element=>{\n   if(n===32&&element.id==='approved32-coastal-foundation'){\n    compatibilityAssetIds.push(element.assetId);\n    return [{...element,assetId:assetId(32,'foundation')}];\n   }",
      "label": "Only Stage32 foundation element visual provider"
    },
    {
      "path": "shared/act4-handoff-art.mjs",
      "old": "   pack.assets.push(joinPortGround(pack.assets.find(a=>a.id===assetId(n,'body'))));",
      "new": "   const joined=joinPortGround(pack.assets.find(a=>a.id===assetId(n,'body')));\n   const protection=JSON.parse(await readFile(new URL('./data/act4/handoff-art/32-material-protection.json',import.meta.url),'utf8'));\n   compatibilityAssetIds.push(joined.id);\n   pack.assets.push(joined,{...joined,id:bodyId,params:{...joined.params,stage32SharedMaterial:protection}});",
      "label": "Keep original/joined assets; add shared material clone and metadata"
    }
  ]
