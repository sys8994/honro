+    return dict(max_silhouette_deviation_px=distance,components_a=int(ndi.label(ma,np.ones((3,3)))[1]),components_b=int(ndi.label(mb,np.ones((3,3)))[1]))
+im=Image.open(src).convert('RGBA');w,h=im.size
