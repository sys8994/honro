+
+def composite(a):
+    return a[:,:,:3]*a[:,:,3:4]/255+255*(1-a[:,:,3:4]/255)
+def silhouette(a,b):
+    ma=a[:,:,3]>=128;mb=b[:,:,3]>=128
+    da=ndi.distance_transform_edt(~ma);db=ndi.distance_transform_edt(~mb)
