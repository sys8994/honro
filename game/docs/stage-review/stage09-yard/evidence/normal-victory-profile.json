{"profile":{"version":2,"revision":13,"cleared":{"1":{"visits":1,"rounds":0},"2":{"visits":1,"rounds":0},"3":{"visits":1,"rounds":0},"4":{"visits":1,"rounds":0},"5":{"visits":1,"rounds":0},"6":{"visits":1,"rounds":0},"7":{"visits":1,"rounds":0},"8":{"visits":1,"rounds":37},"9":{"visits":1,"rounds":2}},"party":["archer","mage","knight"],"loadouts":{"mage":["M01","M04","M11","M09"],"archer":["A01","A02","A03","A11"],"knight":["S00","S01","S04","S09"],"occultist":["O01","O06"]},"tuning":{"mage":0.5,"archer":0.5,"knight":0.5,"occultist":0.5},"settings":{"sound":true,"music":false,"volume":0.35,"assist":false,"shake":true,"quality":"high","difficulty":"normal","speed":2,"playerSpeed":1,"orientation":"landscape","musicVolume":0.65,"minimapVisible":true,"debugTerrainOutline":false},"saved":null,"lastStage":9,"mapNode":1,"tutorial":false,"heroes":{"mage":{"xp":12964,"ranks":{"M01":1,"M06":1,"M02":1,"M04":1,"M03":1,"M11":1,"M07":1,"M10":1,"M08":1,"M09":1},"statTraining":6,"kills":4,"damage":3795,"skillRevision":1,"martialRevision":1},"archer":{"xp":13986,"ranks":{"A01":1,"A14":1,"A02":1,"A05":1,"A04":1,"A07":1,"A03":1,"A11":1},"statTraining":6,"kills":6,"damage":3324,"skillRevision":1,"martialRevision":1},"knight":{"xp":16665,"ranks":{"S00":1,"S01":1,"S06":1,"S04":1,"S09":1},"statTraining":6,"kills":7,"damage":4687,"skillRevision":1,"martialRevision":1},"occultist":{"xp":0,"ranks":{"O01":1,"O06":1},"statTraining":0,"kills":0,"damage":0,"skillRevision":1,"martialRevision":1,"occultRevision":1}},"recruited":["archer","mage","knight"],"schema":4,"game":"honro","seen":{"rest-interlude-v1-8":true,"rest-interlude-v1-9":true},"record":[{"place":"돌아오는 빈 상여","text":"설오 · (발을 멈춘다) 저건… 홍만 어르신을 모셨던 상여 아닙니까? 장례가 끝났는데 왜 움직이지요?\n담허 · 아니야. 홍만 어르신은 장례 때 제대로 떠났네. 빈 상여를 다른 원혼이 그릇으로 삼은 거야.\n설오 · 우리가 끊은 줄과 이어진 겁니까?\n담허 · 그럴 수 있네. 아직은 단정 못 하겠어.\n휘겸 · 주민들 돌아갈 길을 막았소. 상여부터 멈춥시다.\n담허 · 상여채를 붙든 띠부터 끊세. 상여에서 빠져나오는 원혼은 내가 살피겠네."},{"place":"돌아오는 빈 상여","text":"설오 · 상여가 멈췄습니다. 돌아가는 길도 열렸고요.\n담허 · 상여는 멈췄네. 그렇다고 다른 줄까지 다 알았다고 여겨선 안 돼.\n설오 · 이번엔 먼저 소단에게 묻겠습니다. 매듭을 더 끊기 전에.\n휘겸 · 사람들 없는 아랫마당으로 갑시다."},{"place":"바람 없는 마당","text":"설오 · 주민들이 말한 소단이 위에 있을까요? 방울 소리가 저 문간에서 납니다.\n담허 · 빈 마당에 내가 받이진을 펴겠네. 곁으로 몰리는 것들은 막아 주게. 소단이 붉은 실로 붙든 원혼을 나누어 받으면, 줄을 끊지 않고도 부담을 덜 수 있네.\n휘겸 · 아랫마당 양쪽에 빈자리가 있소. 주민들이 빠져나간 그곳에 진을 놓읍시다."},{"place":"바람 없는 마당","text":"담허 · 양쪽 받이진이 이어졌네. 소단이 붙든 원혼을 나눠 받고 있어. 가운데 줄은 건드리지 않았네.\n소단 · 줄이 조금 덜 당겨요. 하지만 윗마당에는 오지 마요. 남은 원혼은 아직 제가 붙들고 있어요.\n설오 · 진이 원혼을 받는 걸 보셨잖습니까. 남은 혼도 함께 옮기게 해주십시오. 혼자 버티다 쓰러지시겠습니다.\n소단 · 폭포에서 당신들이 줄을 풀자 다른 줄까지 당겨졌어요. 진이 조금 받아 줬다고, 제가 가운데 줄을 놓아도 안전할까요?\n담허 · 우리가 끊었네. 다른 줄까지 살피지 못했어. 이번엔 자네가 놓으라고 할 때까지 가운데는 두겠네.\n소단 · 주민을 살리고 싶은 건 저도 같아요. 그래도 제 줄을 건드리게 둘 순 없어요. 따라오면 주박으로 막겠어요. 다치더라도요.\n설오 · 가운데 줄은 건드리지 않겠습니다. 하지만 당신이 쓰러지면 주민들도 위험합니다. 위에서 원혼을 안전하게 옮길 수 있다는 걸 보여드리겠습니다."}],"honroFlags":{"cleared-8":true,"cleared-9":true},"honroGrowth":{"version":4,"stages":{"1":{"policy":3,"combat":{},"cleared":true,"limit":{"start":0,"end":180,"total":180,"combat":72}},"2":{"policy":3,"combat":{},"cleared":true,"limit":{"start":180,"end":450,"total":270,"combat":108}},"3":{"policy":3,"combat":{},"cleared":true,"limit":{"start":675,"end":1137,"total":462,"combat":185}},"4":{"policy":3,"combat":{},"cleared":true,"limit":{"start":1137,"end":1868,"total":731,"combat":292}},"5":{"policy":3,"combat":{},"cleared":true,"limit":{"start":1868,"end":2934,"total":1066,"combat":426}},"6":{"policy":3,"combat":{},"cleared":true,"limit":{"start":2934,"end":4395,"total":1461,"combat":584}},"7":{"policy":3,"combat":{},"cleared":true,"limit":{"start":4395,"end":7512,"total":3117,"combat":1247}},"8":{"combat":{},"cleared":true,"limit":{"start":7287,"end":11455,"total":4168,"combat":1667},"contribution":{"version":4,"rewardBalance":1,"sequence":331,"total":12504,"combatLimit":5001,"actors":["archer","knight","mage"],"factors":{"archer":1,"mage":1,"knight":1},"owners":{"p-archer":"archer","p-mage":"mage","p-knight":"knight"},"enemies":{"s8-0":{"id":"s8-0","hp":409,"weight":1,"progr