"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:5","speakerPolicy":"context-portrait"}}],["설오","실례지만 망자의 성함을 여쭤도 됩니까?",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:6","speakerPolicy":"context-portrait"}}],["연실","홍만이에요. 연목 나루에서 배를 모셨어요.",{"revealName":{"unitId":"objective","name":"홍만의 상여"},"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:7","speakerPolicy":"context-portrait"}}],["설오","……연목 나루의 홍만.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:8","speakerPolicy":"context-portrait"}}],["서술","설오는 상여를 바라보다가 활을 내려놓았다.",{"kind":"narration","art":"bier","storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","presentation":"inline","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:9","speakerPolicy":"none"}}],["연실","아버지를 아세요?",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:10","speakerPolicy":"context-portrait"}}],["설오","오늘 처음 뵈려고 왔습니다. 몇 해 전 북쪽 산사람들을 태웠다는 말을 듣고요. 사라진 제 고향 사람들입니다.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:11","speakerPolicy":"context-portrait"}}],["연실","그 기록은 버리지 말라고 하셨어요. 사람과 짐을 적은 장부가 나루 움막에 있어요.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:12","speakerPolicy":"context-portrait"}}],["설오","배를 태운 뒤 어디로 갔는지도 적혀 있을까요?",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:13","speakerPolicy":"context-portrait"}}],["연실","제가 내용을 다 보진 못했어요. 하지만 아버지는 아프실 때도 그 장부를 자꾸 찾으셨어요.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:14","speakerPolicy":"context-portrait"}}],["설오","고맙습니다. 살아 계실 때 왔어야 했는데.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:15","speakerPolicy":"context-portrait"}}],["담허","장부를 보러 갈 때 나도 함께 가지.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:16","speakerPolicy":"context-portrait"}}],["설오","장례는 끝났는데, 괜찮으십니까?",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:17","speakerPolicy":"context-portrait"}}],["담허","오늘 이 길에서 만난 들림이 지난달 내가 이 고을에서 본 것보다 많아. 그릇을 옮겨 다니는 속도도 심상치 않고. 이유를 확인해야겠네.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:18","speakerPolicy":"context-portrait"}}],["설오","저는 사람들의 행방을, 어른은 들림이 늘어난 까닭을 찾는 거군요. 나루부터 보겠습니다.",{"storyId":"act1-v6:outcome-2","storyTitle":"상여 위의 높은 길","stagingScene":"direction-v2:outcome-2","camera":{"intent":"conversation","allowOffscreenSpeaker":true,"targets":[{"actor":"objective"},{"actor":"npc-damheo"},{"actor":"npc-yeonsil"}],"padding":45,"maxScale":1,"id":"2:outcome:19","speakerPolicy":"context-portrait"}}]]}],"honroJourney":{"version":1,"talked":{},"growthObserved":{"session":"honro-map-stage-2-1792602797074","earned":{"archer":5,"mage":7}},"newGrowth":{"archer":{"stageId":2,"spent":2,"points":2}}}}