    honroFieldEvidenceVersion: 1,
    honroNarrativeContent: {
      id: 3,
      name: '나루의 남은 장부',
      level: 3,
      theme: 'river',
      template: 4,
      objective: 'ledger',
      goal: '홍만의 나루 움막에서 장부 회수',
      w: 9400,
      h: 2500,
      map: [ 1080, 760 ],
      requires: [ 2 ],
      enemies: 6,
      active: 3,
      narrationArt: 'ferry',
      narration: [
        '홍만은 이미 세상을 떠났다. 설오는 그의 딸 연실이 알려 준 장부를 찾아 담허와 나루로 내려왔다. 빈 움막 앞에서 낯선 검객 하나가 두 사람을 향해 손을 들었다.'
      ],
      story: [
        [ '휘겸', '멈추시오. 저 장승이 물 밖으로 기어 나왔소. 그쪽은 위험하오.' ],
        [ '설오', '(활을 내리지 않은 채) 나루를 지키는 분입니까? 사람들은 어디로 갔지요?' ],
        [
          '휘겸',
          '휘겸이라 하오. 서쪽 길에서 피란민을 데려오다 여기 발이 묶였소. 걸을 수 있는 사람은 마을 문으로 먼저 보냈소.'
        ],
        [
          '설오',
          '저는 설오입니다. 홍만 어르신의 장부를 찾으러 왔습니다. 저 움막에 있다고 들었습니다.',
          { focus: 'interact' }
        ],
        [
          '휘겸',
          '홍만 어르신이라면… 부고를 들었소. 움막은 아직 못 살폈소. 내가 장승의 눈을 끄는 동안 들어가 보시오.'
        ],
        [
          '담허',
          '나는 담허라 하네. 장승에서 빠져나온 혼은 내가 진으로 받아 다른 몸에 붙지 못하게 하겠네. 혼자 남아 애썼구먼.'
        ]
      ],
      storyFollowups: [
        [
          [ '설오', '어른, 장승의 몸을 부숴도 그 안의 혼은 남는 겁니까?' ],
          [
            '담허',
            '그렇네. 죽은 뒤에도 떠나지 못한 혼, 원혼이 들어 있는 거야. 죽은 사람이 모두 그렇게 되는 건 아니야.'
          ],
          [ '설오', '저 장승도… 누군가의 혼이 들어 움직이는 겁니까?' ],
          [ '담허', '그래. 사람이나 짐승, 저런 물건도 그릇이 되네. 부수고 끝낼 수 없는 까닭이지.' ]
        ],
        [
          [ '설오', '몸에서 떼어 놓은 뒤에는 어디로 보냅니까?' ],
          [
            '담허',
            '땅에 진을 펴서 원혼을 받아 두네. 사람에게 다시 붙지 못하게 하는 자리라 받이진이라 하지.'
          ],
          [ '설오', '그럼 몸을 부수기 전에 원혼을 받아 둘 진부터 마련해야겠군요.' ],
          [ '담허', '(빈 움막을 돌아보며) 여기 남은 것도 살펴야겠네. 서두르되 함부로 부수지는 말게.' ]
        ]
      ],
      outro: [
        [ '설오', '고향 사람들 다음 행선지가 남아 있어 다행입니다.' ],
        [ '휘겸', '나는 북문으로 먼저 가겠소. 아직 문 밖에 남은 사람들이 있소.' ],
        [ '설오', '우리도 가겠습니다.' ]
      ],
      storySummary: '고향 사람들은 연목 주막에 묵은 뒤 북문으로 이동했다. 붉은 실에는 무언가 걸려 있다. 함부로 끊지 말고 맨 사람을 찾아야 한다. 다음 목적지는 연목 마을이다.',
      guide: '움막의 기록함에서 홍만의 장부를 챙기세요. 홍만이 남긴 행선지를 동행과 확인합니다.'
    },
