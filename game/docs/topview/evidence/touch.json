    {
      "at_s": 39.43,
      "input": "다음",
      "state": "머리 위에서 까마귀 떼가 내리꽂힌다. 위쪽 사선도 봐야겠군."
    },
    {
      "at_s": 39.9,
      "input": "다음",
      "state": "수레 뒤에 몸을 숨겼던 나무꾼이 설오의 목소리에 수레 곁으로 몸을 내민다."
    },
    {
      "at_s": 40.22,
      "input": "다음",
      "state": "거기 활 든 양반! 짐승들은 다 쫓았소?"
    },
    {
      "at_s": 40.35,
      "input": "다음",
      "state": "수레 곁에 있던 놈들은 정리했습니다. 다친 데는 없으십니까?"
    },
    {
      "at_s": 40.49,
      "input": "다음",
      "state": "몸은 성하오. 어젯밤에 갑자기 짐말이 미쳐 날뛰더니, 거품을 물고 쓰러지자마자 산개가 눈이 뒤집혀 덮쳤소."
    },
    {
      "at_s": 40.58,
      "input": "다음",
      "state": "말이 쓰러질 때, 그 몸에서 무언가 빠져나오는 걸 보셨습니까?"
    },
    {
      "at_s": 40.66,
      "input": "다음",
      "state": "그런 걸 볼 정신이 어딨소! 수레 밑으로 기어들어가 숨 죽이느라 바빴지. 저 짐승들이 밤새도록 저 지경이었소."
    },
    {
      "at_s": 40.74,
      "input": "다음",
      "state": "이 고개에 원래도 이런 일이 있었습니까?"
    },
    {
      "at_s": 40.82,
      "input": "다음",
      "state": "어쩌다 한 번씩이야 있었지, 이렇게 산 전체가 들썩이는 건 처음이오. 밤엔 산 위에서 웬 종소리까지 울리고……."
    },
    {
      "at_s": 40.91,
      "input": "다음",
      "state": "저 위에 절이 있습니까?"
    },
    {
      "at_s": 40.99,
      "input": "다음",
      "state": "내 평생 저 산에 절이 있단 소리는 못 들었소. 아, 맞다! 조금 전에 아래 골짜기로 장례 행렬이 내려갔는데, 그 길에도 짐승들이 득실거릴 텐데……."
    },
    {
      "at_s": 41.07,
      "input": "다음",
      "state": "수레 곁에서 나오지 마십시오. 아래 행렬은 제가 내려가 보겠습니다."
    },
