+ if(finish)insist(outcome?.stage===60&&outcome.won===true&&outcome.settlement===false&&outcome.flags?.['act6.lastSoulsGuided']===true&&outcome.flags?.['act6.endingStarted']===true,'owner did not issue actual ending capability');
