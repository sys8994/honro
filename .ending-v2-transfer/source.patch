+    ]
+  }
+];
+export const selectEndingCue=(cuts,ms)=>{
+ const sec=Math.max(ms,0)/1000;
+ let start=0;
+ for(const [index,cut] of cuts.entries()){
+  const time=sec-start;
+  if(time<cut.duration){
+   const final=cut.id==='final', beat=final?(time<14?0:time<34?1:2):Math.min(cut.beats.length-1,Math.floor(time/(cut.duration/cut.beats.length)));
+   return {index,beat,time,cut,final};
+  }
+  start+=cut.duration;
+ }
+ return null;
+};
+export const cueAt=ms=>selectEndingCue(cuts,ms);
